{
  "manifest_version": 3,
  "name": "Teletela — Assistir juntos",
  "version": "0.1.0",
  "description": "Sincroniza YouTube e Netflix com os amigos da sua call no Teletela. Experimental.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://www.youtube.com/*", "https://www.netflix.com/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Assistir juntos no Teletela" },
  "content_scripts": [
    { "matches": ["https://www.netflix.com/*"], "js": ["netflix-bridge.js"], "world": "MAIN", "run_at": "document_start" },
    { "matches": ["https://www.youtube.com/*", "https://www.netflix.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
