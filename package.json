{
  "name": "telinha",
  "version": "3.8.0",
  "description": "Transmissão de tela P2P (WebRTC) e voz estilo Discord/TeamSpeak com áudio de sistema independente",
  "type": "module",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "app": "sh -c '($(command -v electron || ls /usr/lib/electron*/electron | head -n1) electron/main.cjs)'",
    "test": "node tests/runner.js",
    "test:microphone": "sh -c '($(command -v electron || ls /usr/lib/electron*/electron | head -n1) tests/microphone-browser.cjs)'",
    "test:microphone:ui": "sh -c '($(command -v electron || ls /usr/lib/electron*/electron | head -n1) tests/microphone-controls.cjs)'",
    "test:mobile": "sh -c '($(command -v electron || ls /usr/lib/electron*/electron | head -n1) tests/mobile-browser.cjs)'",
    "test:permissions": "sh -c '($(command -v electron || ls /usr/lib/electron*/electron | head -n1) tests/permissions-browser.cjs)'",
    "sfu": "go run ./sfu",
    "dist:linux": "electron-builder --linux",
    "dist:win": "npm run build:win-audio && electron-builder --win nsis portable",
    "dist": "npm run build:win-audio && electron-builder --linux --win",
    "build:win-audio": "sh native/win-audio/build.sh",
    "build:android": "bash scripts/build-android.sh",
    "release": "npm run build:win-audio && GH_TOKEN=$(gh auth token) electron-builder --linux --win --publish always",
    "deploy:oracle": "bash deploy/oracle/deploy.sh",
    "backup": "bash deploy/oracle/backup.sh",
    "backup:auto": "bash deploy/oracle/backup-auto.sh",
    "restore": "bash deploy/oracle/restore.sh"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@sapphi-red/web-noise-suppressor": "^0.4.1",
    "electron-builder": "^26.15.3",
    "socket.io-client": "^4.8.1"
  },
  "engines": {
    "node": ">=20.11"
  },
  "author": "castzin",
  "build": {
    "appId": "com.castzin.telinha",
    "productName": "Teletela",
    "electronVersion": "42.11.11",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "public/**",
      "server.js",
      "permission-store.js",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "AudioVideo",
      "artifactName": "Teletela.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "artifactName": "Teletela-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Teletela-Portatil.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Castzzz",
        "repo": "telinha",
        "releaseType": "release"
      }
    ]
  },
  "desktopName": "telinha.desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/Castzzz/telinha.git"
  },
  "optionalDependencies": {
    "uiohook-napi": "^1.5.5"
  }
}
